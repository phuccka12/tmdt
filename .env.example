### Backend (.env) - keep this file out of version control and never commit secrets
# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Optional admin key used by some admin endpoints
ADMIN_API_KEY=your_admin_api_key_here

# PayPal (Sandbox or Live)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# The webhook ID from PayPal (WH-...); required for webhook verification
PAYPAL_WEBHOOK_ID=WH_xxx_your_webhook_id
# Return/cancel URLs used when creating PayPal orders (optional overrides)
PAYPAL_RETURN_URL=http://localhost:5173/checkout/success
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel

# Optional: convert VND->USD rate used for sandbox PayPal calls
VND_USD_RATE=23000

# Momo (test)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_NOTIFY_URL=https://your-public-ngrok-or-domain/momo-webhook
MOMO_RETURN_URL=http://localhost:5173/checkout/success

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/checkout/success

# Node/Server
PORT=54321

# Frontend (Vite) - create .env (or .env.local) with VITE_ prefix for client
# Example: .env.local in project root
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are required for the frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_BACKEND_URL=http://localhost:54321
